      adminLang = lang;
      localStorage.setItem('ef_admin_lang', lang);
      (document.getElementById('admin-lang-select') as HTMLSelectElement).value = lang;
      (document.getElementById('login-lang-select') as HTMLSelectElement).value = lang;
      applyAdminLang(lang);
    }
    document.getElementById('admin-lang-select')!.addEventListener('change', (e) => {
      switchAdminLang((e.target as HTMLSelectElement).value);
    });
    document.getElementById('login-lang-select')!.addEventListener('change', (e) => {
      switchAdminLang((e.target as HTMLSelectElement).value);
    });

    function applyAdminLang(lang: string, scope?: Element) {
      const dict = ADMIN_I18N[lang] || {};
      if (lang === 'en') {
        if (!scope) location.reload();
        return;
      }
      const root = scope || document;
      const translate = (el: Element) => {
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT') return;
        el.childNodes.forEach(node => {
          if (node.nodeType === 3) {
            const text = node.textContent?.trim();
            if (text && dict[text]) node.textContent = dict[text];
          }
        });
      };
      root.querySelectorAll('label, button, h1, h2, h3, h4, th, span, .stat-label, .cfg-section-title, .cfg-section-desc, .cfg-card-title, .picker-item-label, .admin-tab, .cfg-mode-btn, .cfg-empty-title, .cfg-empty-desc, .cfg-be-header-title, .cfg-be-header-desc, .be-field label, .be-section-title, .be-add-btn').forEach(translate);
      root.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(el => {
        const input = el as HTMLInputElement;
        const ph = input.placeholder;
        if (ph && dict[ph]) input.placeholder = dict[ph];
      });
      root.querySelectorAll('select option').forEach(opt => {
        const text = opt.textContent?.trim();
        if (text && dict[text]) opt.textContent = dict[text];
      });
    }
    function reapplyLang(scope?: Element) {
      if (adminLang !== 'en') applyAdminLang(adminLang, scope);
    }
  </script>
</Base>

<style is:global>
