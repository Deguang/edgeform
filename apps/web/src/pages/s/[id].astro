---
/**
 * Dynamic site renderer.
 *
 *   /s/{token}  →  resolves token via slug:{token} → site id, OR
 *                  falls back to site:{token} for legacy sites where the
 *                  URL is the immutable primary key.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import SiteEngine from '../../components/renderer/SiteEngine.astro';
import { loadSiteByPathToken } from '../../lib/slug-map';

const { id: token } = Astro.params;

const resolved = token ? await loadSiteByPathToken(token) : null;
if (!resolved) return new Response('Site not found', { status: 404 });

const { id: siteId, config } = resolved;
const title = config.title || 'EdgeForm';
const description = config.description || '';
---

<Base title={title} description={description} favicon={config.favicon || config.theme?.logoUrl || undefined} analytics={config.analytics}>
  <SiteEngine config={config} apiBase="" siteId={siteId} />
</Base>
