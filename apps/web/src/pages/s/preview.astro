---
/**
 * Dynamic site renderer — loads config from KV (or query param for preview).
 * SSR endpoint: prerender = false.
 */
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import SiteEngine from '../../components/renderer/SiteEngine.astro';
import fallbackConfig from '../../schemas/waitlist.json';

const KV_KEY = 'site:config';

let config: any;
let title = 'EdgeForm';
let description = '';

// Preview mode: config passed via query param
const previewParam = Astro.url.searchParams.get('_preview');
if (previewParam) {
  try {
    config = JSON.parse(previewParam);
  } catch {
    config = fallbackConfig;
  }
} else {
  // Production: load from KV
  try {
    const stored = await env.FORM_KV.get(KV_KEY, 'text');
    config = stored ? JSON.parse(stored) : fallbackConfig;
  } catch {
    config = fallbackConfig;
  }
}

title = config.title || 'EdgeForm';
description = config.description || config.pages?.[0]?.blocks?.[0]?.description || '';
---

<Base title={title} description={description}>
  <SiteEngine config={config} apiBase="" />
</Base>
