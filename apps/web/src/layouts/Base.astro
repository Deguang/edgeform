---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  favicon?: string;
  analytics?: { ga4Id?: string };
}

const {
  title,
  description = 'Edge-native micro-site engine — one JSON, five themes, zero cost. Built on Cloudflare Workers, KV, D1.',
  canonical,
  favicon,
  analytics,
} = Astro.props;
// Only inject GA when a well-formed measurement ID is configured.
const ga4Id = (analytics?.ga4Id || '').trim();
const ga4Valid = /^G-[A-Z0-9]+$/i.test(ga4Id);
const ogImage = new URL('/og.png', Astro.site || 'https://page.lideguang.com').href;
const canonicalUrl = canonical || Astro.url.href;
// Resolve sibling /llms.txt for the current path (works for / and /s/{id}).
const llmsHref = Astro.url.pathname.replace(/\/?$/, '/') + 'llms.txt';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="EdgeForm" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "EdgeForm",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Web",
    "description": description,
    "url": canonicalUrl,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })} />

  <link rel="icon" type={favicon ? undefined : 'image/svg+xml'} href={favicon || '/favicon.svg'} />
  <!-- LLM-readable site description (https://llmstxt.org/) -->
  <link rel="alternate" type="text/markdown" title="LLMs.txt" href={llmsHref} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

  {ga4Valid && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(ga4Id)});`}></script>
    </>
  )}
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --border: #1e1e2e;
    --text: #e2e8f0;
    --text-dim: #64748b;
    --accent: #f97316;
    --accent-glow: rgba(249, 115, 22, 0.15);
    --green: #22c55e;
    --red: #ef4444;
    --mono: 'JetBrains Mono', monospace;
    --sans: 'Inter', system-ui, sans-serif;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }
</style>
