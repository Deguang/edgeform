---
/**
 * SiteEngine — EdgeForm's block-based rendering engine.
 *
 * Responsibilities:
 * - Fullpage scroll navigation
 * - Theme switching (schema-driven)
 * - Form submission handling
 *
 * Does NOT contain any theme-specific rendering or styles.
 * All visual output is delegated to the theme registry.
 */
interface Props {
  config: any;
  apiBase?: string;
  siteId?: string;
}

const { config, apiBase = '', siteId = 'config' } = Astro.props;

const switcher = config.themeSwitcher || { enabled: false };
---

<!-- Shared block styles + theme CSS imports (must be global for JS-rendered content) -->
<style is:global>@import '../../themes/shared-blocks.css';</style>
<style is:global>@import '../../themes/glass/style.css';</style>
<style is:global>@import '../../themes/terminal/style.css';</style>
<style is:global>@import '../../themes/brutal/style.css';</style>
<style is:global>@import '../../themes/minimal/style.css';</style>
<style is:global>@import '../../themes/retro/style.css';</style>
<style is:global>@import '../../themes/light/style.css';</style>
<style is:global>@import '../../themes/soft/style.css';</style>

<div
  id="ef-root"
  data-config={JSON.stringify(config)}
  data-api-base={apiBase}
  data-site-id={siteId}
>
  {!config.topNav?.enabled && (config.theme?.logoUrl || config.theme?.brandName || config.title) && (
    <div class="ef-site-brand" id="ef-site-brand">
      {config.theme?.logoUrl && (
        <img class="ef-brand-logo" src={config.theme.logoUrl} alt={config.theme?.brandName || config.title || 'Logo'} />
      )}
      {(config.theme?.brandName || (!config.theme?.logoUrl && config.title)) && (
        <span class="ef-brand-name">{config.theme?.brandName || config.title}</span>
      )}
    </div>
  )}

  {switcher.enabled && (
    <nav class={`ef-switcher ef-sw-${switcher.position || 'top-right'}`} id="ef-switcher">
      <button class="ef-sw-toggle" id="ef-sw-toggle" aria-label="Theme" aria-expanded="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
          <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
          <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
          <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
        </svg>
      </button>
      <span class="ef-sw-label">Theme</span>
      <div class="ef-sw-pills" id="ef-pills"></div>
    </nav>
  )}

  <nav class="ef-lang-picker" id="ef-lang-picker" style="display:none">
    <button class="ef-sw-toggle" id="ef-lang-toggle" aria-label="Language" aria-expanded="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M2 12h20"/>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
    </button>
    <span class="ef-sw-label">Lang</span>
    <div class="ef-sw-pills" id="ef-lang-pills"></div>
  </nav>

  {config.topNav?.enabled && (
    <nav class="ef-topnav" id="ef-topnav">
      <div class="ef-topnav-inner">
        <a class="ef-topnav-brand" id="ef-topnav-brand" href="#">
          {config.theme?.logoUrl && (
            <img class="ef-topnav-logo" src={config.theme.logoUrl} alt={config.theme?.brandName || config.title || 'Logo'} />
          )}
          {(config.theme?.brandName || config.title) && (
            <span class="ef-topnav-brandname">{config.theme?.brandName || config.title}</span>
          )}
        </a>
        <ul class="ef-topnav-links" id="ef-topnav-links"></ul>
        <button class="ef-topnav-toggle" id="ef-topnav-toggle" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  )}

  <div class="ef-dots" id="ef-dots"></div>

  <div class="ef-scroll-hint" id="ef-scroll-hint">
    <div class="ef-scroll-arrow"></div>
  </div>

  <div id="ef-pages" class="ef-pages"></div>

  <div id="ef-latency" class="ef-badge hidden"></div>

  <a class="ef-powered" href="https://page.lideguang.com/" target="_blank" rel="noopener">
    Built with <strong>EdgeForm</strong>
  </a>
</div>

<script>
  import { themeRegistry, getTheme } from '../../themes/registry';
  import type { ThemeDefinition } from '../../themes/types';

  // ============================================================
  // SiteEngine Runtime
  // ============================================================

  const root = document.getElementById('ef-root')!;
  const siteConfig = JSON.parse(root.dataset.config!);
  const apiBase: string = root.dataset.apiBase || '';
  const siteId: string = root.dataset.siteId || 'config';

  // --- Inject CSS custom properties from theme config ---
  // Brand accent is the single source of truth. We derive related shades so
  // every theme's accent (gradient stops, hovers, glows, soft tints) tracks the
  // same brand color without each theme having to redefine them.
  function hexToRgb(hex: string): [number, number, number] | null {
    const m = hex.replace('#', '').match(/^([0-9a-f]{6}|[0-9a-f]{3})$/i);
    if (!m) return null;
    let h = m[1];
    if (h.length === 3) h = h.split('').map(c => c + c).join('');
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }
  function shade([r, g, b]: [number, number, number], pct: number): string {
    // pct < 0 = darker, pct > 0 = lighter
    const k = pct / 100;
    const f = (c: number) => Math.max(0, Math.min(255, Math.round(c + (k > 0 ? (255 - c) : c) * k)));
    return `rgb(${f(r)}, ${f(g)}, ${f(b)})`;
  }
  // Relative luminance per WCAG. Used to pick a readable text color when the
  // accent is the background — light/yellow brand colors otherwise eat white text.
  function luminance([r, g, b]: [number, number, number]): number {
    const f = (c: number) => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  }
  function applyAccentVars(color: string) {
    const root = document.documentElement.style;
    root.setProperty('--ef-primary', color);
    root.setProperty('--accent', color);
    const rgb = hexToRgb(color);
    if (!rgb) return;
    root.setProperty('--accent-dark', shade(rgb, -18));
    root.setProperty('--accent-deep', shade(rgb, -40));
    root.setProperty('--accent-light', shade(rgb, 18));
    root.setProperty('--accent-soft', `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, 0.1)`);
    root.setProperty('--accent-glow', `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, 0.4)`);
    root.setProperty('--accent-rgb', `${rgb[0]}, ${rgb[1]}, ${rgb[2]}`);
    // Contrast-aware text color for "on accent" surfaces (CTAs, badges, chips).
    // Threshold 0.55 keeps yellow/lime/cream brands flipping to dark text rather
    // than white-on-pale.
    const lum = luminance(rgb);
    root.setProperty('--accent-on', lum > 0.55 ? '#0f0f12' : '#ffffff');
    // Tint variants used as card backgrounds — derived from accent so the
    // highlight tracks the brand instead of inventing per-theme palette colors.
    root.setProperty('--accent-tint', `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, 0.08)`);
    root.setProperty('--accent-tint-strong', `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, 0.14)`);
  }
  const primaryColor = siteConfig.theme?.primaryColor || '';
  if (primaryColor) applyAccentVars(primaryColor);

  // Light-background themes need body + UI overrides (Base.astro defaults to dark)
  const lightThemes = ['light', 'soft', 'minimal'];
  function applyColorMode(themeName: string) {
    const isLight = lightThemes.includes(themeName);
    const root = document.documentElement;
    document.body.style.background = isLight ? '#faf8f5' : '';
    document.body.style.color = isLight ? '#1e293b' : '';
    // Unified UI variables for overlays: pills, dots, labels
    root.style.setProperty('--ui-panel', isLight ? 'rgba(255,255,255,0.85)' : '');
    root.style.setProperty('--ui-border', isLight ? 'rgba(0,0,0,0.08)' : '');
    root.style.setProperty('--ui-shadow', isLight ? '0 4px 20px rgba(0,0,0,0.08)' : '');
    root.style.setProperty('--ui-dim', isLight ? 'rgba(0,0,0,0.3)' : '');
    root.style.setProperty('--ui-text', isLight ? 'rgba(0,0,0,0.7)' : '');
    root.style.setProperty('--ui-hover', isLight ? 'rgba(0,0,0,0.05)' : '');
  }
  applyColorMode(siteConfig.theme?.name || 'glass');

  // --- Theme config from schema ---
  const switcherConfig = siteConfig.themeSwitcher || { enabled: false };
  const availableThemes: string[] = switcherConfig.enabled
    ? (switcherConfig.themes || Object.keys(themeRegistry))
    : [siteConfig.theme?.name || 'glass'];
  const switcherEnabled: boolean = switcherConfig.enabled && availableThemes.length > 1;

  let currentTheme: string = siteConfig.theme?.name || switcherConfig.defaultTheme || 'glass';
  // Navigation: 'fullpage' (snap on wheel/touch) or 'scroll' (free scroll).
  // Legacy 'none' value migrates to 'scroll' with dots hidden.
  // Mobile (<=720px) is auto-downgraded to scroll: fullpage's wheel/touch
  // hijack would trap users inside long blocks they can't read end-to-end.
  // Industry-standard pattern (fullpage.js, Apple marketing pages, etc).
  const rawNav: string = siteConfig.navigation || 'fullpage';
  const isMobileViewport = window.matchMedia('(max-width: 720px)').matches;
  const navMode: string = (rawNav === 'fullpage' && !isMobileViewport) ? 'fullpage' : 'scroll';
  // Hide dots when downgraded — they don't correspond to anything snappable.
  const dotsRequested = rawNav === 'none' ? false : (siteConfig.showPageDots !== false);
  const showDots: boolean = dotsRequested && !(rawNav === 'fullpage' && isMobileViewport);

  // Re-evaluate when the viewport crosses the threshold (orientation change,
  // window resize). Threading the swap through the live runtime is more risk
  // than reward; reload to get a clean init in the new mode. Debounced.
  if (rawNav === 'fullpage') {
    let resizeTimer: number | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const nowMobile = window.matchMedia('(max-width: 720px)').matches;
        if (nowMobile !== isMobileViewport) location.reload();
      }, 250);
    });
  }
  let currentPage = 0;
  let isScrolling = false;
  const totalPages = siteConfig.pages.length;

  // URL override
  if (switcherEnabled) {
    const urlTheme = new URLSearchParams(location.search).get('theme');
    if (urlTheme && availableThemes.includes(urlTheme)) currentTheme = urlTheme;
  }

  // --- i18n ---
  const i18nMap: Record<string, Record<string, string>> = siteConfig.i18n_map || {};
  const targetLangs = Object.keys(i18nMap);
  const hasI18n = targetLangs.length > 0;
  const sourceLangLabel = siteConfig.translate_settings?.sourceLang?.toUpperCase() || 'EN';
  let currentLang = ''; // empty = source language

  if (hasI18n) {
    const urlLang = new URLSearchParams(location.search).get('lang');
    if (urlLang && i18nMap[urlLang]) currentLang = urlLang;
  }

  function t(text: string): string {
    if (!currentLang || !i18nMap[currentLang]) return text;
    return i18nMap[currentLang][text] || text;
  }

  function translateBlock(block: any): any {
    const b = JSON.parse(JSON.stringify(block));
    switch (b.type) {
      case 'hero':
        if (b.title) b.title = t(b.title);
        if (b.subtitle) b.subtitle = t(b.subtitle);
        if (b.description) b.description = t(b.description);
        if (b.cta?.label) b.cta.label = t(b.cta.label);
        break;
      case 'features':
        if (b.heading) b.heading = t(b.heading);
        for (const item of b.items || []) {
          if (item.title) item.title = t(item.title);
          if (item.description) item.description = t(item.description);
          if (item.tag) item.tag = t(item.tag);
        }
        break;
      case 'form':
        if (b.heading) b.heading = t(b.heading);
        if (b.description) b.description = t(b.description);
        if (b.submitLabel) b.submitLabel = t(b.submitLabel);
        if (b.successMessage) b.successMessage = t(b.successMessage);
        for (const f of b.fields || []) {
          if (f.label) f.label = t(f.label);
          if (f.placeholder) f.placeholder = t(f.placeholder);
          if (f.options) f.options = f.options.map((o: string) => t(o));
        }
        for (const step of b.steps || []) {
          if (step.title) step.title = t(step.title);
          if (step.label) step.label = t(step.label);
          for (const f of step.fields || []) {
            if (f.label) f.label = t(f.label);
            if (f.placeholder) f.placeholder = t(f.placeholder);
            if (f.options) f.options = f.options.map((o: string) => t(o));
          }
        }
        break;
      case 'text':
        if (b.content) b.content = t(b.content);
        break;
      case 'image':
        if (b.alt) b.alt = t(b.alt);
        if (b.caption) b.caption = t(b.caption);
        break;
      case 'pricing':
        if (b.heading) b.heading = t(b.heading);
        if (b.description) b.description = t(b.description);
        for (const plan of b.plans || []) {
          if (plan.name) plan.name = t(plan.name);
          if (plan.description) plan.description = t(plan.description);
          if (plan.cta?.label) plan.cta.label = t(plan.cta.label);
          if (plan.features) plan.features = plan.features.map((f: string) => t(f));
        }
        break;
      case 'links':
        if (b.heading) b.heading = t(b.heading);
        if (b.avatar?.alt) b.avatar.alt = t(b.avatar.alt);
        for (const item of b.items || []) {
          if (item.label) item.label = t(item.label);
          if (item.description) item.description = t(item.description);
        }
        break;
      case 'countdown':
        if (b.heading) b.heading = t(b.heading);
        if (b.description) b.description = t(b.description);
        if (b.expiredMessage) b.expiredMessage = t(b.expiredMessage);
        if (b.labels) {
          if (b.labels.days) b.labels.days = t(b.labels.days);
          if (b.labels.hours) b.labels.hours = t(b.labels.hours);
          if (b.labels.minutes) b.labels.minutes = t(b.labels.minutes);
          if (b.labels.seconds) b.labels.seconds = t(b.labels.seconds);
        }
        break;
      case 'footer':
        if (b.text) b.text = t(b.text);
        for (const link of b.links || []) {
          if (link.label) link.label = t(link.label);
        }
        break;
      case 'faq':
        if (b.heading) b.heading = t(b.heading);
        if (b.description) b.description = t(b.description);
        for (const item of b.items || []) {
          if (item.question) item.question = t(item.question);
          if (item.answer) item.answer = t(item.answer);
        }
        break;
      case 'testimonials':
        if (b.heading) b.heading = t(b.heading);
        for (const item of b.items || []) {
          if (item.quote) item.quote = t(item.quote);
        }
        break;
      case 'logos':
        if (b.heading) b.heading = t(b.heading);
        break;
      case 'video':
        if (b.heading) b.heading = t(b.heading);
        if (b.caption) b.caption = t(b.caption);
        break;
    }
    return b;
  }

  // --- Theme Switcher Pills ---
  function buildPills() {
    if (!switcherEnabled) return;
    const c = document.getElementById('ef-pills');
    if (!c) return;
    c.innerHTML = '';
    for (const name of availableThemes) {
      const theme = getTheme(name);
      const b = document.createElement('button');
      b.className = `ef-pill${name === currentTheme ? ' active' : ''}`;
      b.textContent = theme.label;
      b.addEventListener('click', () => switchTheme(name));
      c.appendChild(b);
    }
  }

  function switchTheme(name: string) {
    if (!switcherEnabled || name === currentTheme) return;
    currentTheme = name;
    applyColorMode(name);
    const url = new URL(location.href);
    url.searchParams.set('theme', name);
    history.replaceState(null, '', url.toString());
    buildPills();
    renderAllPages();
  }

  // --- Top Nav (optional, derived from block headings) ---
  const topNavEnabled: boolean = !!siteConfig.topNav?.enabled;

  // Pull a label out of a block. Hero uses `title`; everything else uses
  // `heading`. Blocks without a meaningful label are skipped.
  function topNavLabel(block: any): string | null {
    if (!block) return null;
    if (block.type === 'hero') {
      const t = (block.title || '').trim();
      if (t) return t.length > 24 ? t.slice(0, 22) + '…' : t;
      return 'Home';
    }
    const h = (block.heading || '').trim();
    if (!h) return null;
    return h.length > 24 ? h.slice(0, 22) + '…' : h;
  }

  function buildTopNav() {
    if (!topNavEnabled) return;
    const links = document.getElementById('ef-topnav-links');
    if (!links) return;
    links.innerHTML = '';
    siteConfig.pages.forEach((page: any, pIdx: number) => {
      page.blocks.forEach((block: any, bIdx: number) => {
        const label = topNavLabel(block);
        if (!label) return;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'ef-topnav-link';
        a.href = `#ef-block-${pIdx}-${bIdx}`;
        a.textContent = currentLang ? t(label) : label;
        a.dataset.pageIdx = String(pIdx);
        a.dataset.blockIdx = String(bIdx);
        a.addEventListener('click', (e) => {
          e.preventDefault();
          gotoBlock(pIdx, bIdx);
          // Close the mobile menu after picking an item.
          document.getElementById('ef-topnav')!.classList.remove('ef-topnav-open');
          document.getElementById('ef-topnav-toggle')!.setAttribute('aria-expanded', 'false');
        });
        li.appendChild(a);
        links.appendChild(li);
      });
    });

    // Brand click → first page
    const brand = document.getElementById('ef-topnav-brand');
    if (brand) {
      brand.addEventListener('click', (e) => {
        e.preventDefault();
        gotoBlock(0, 0);
      });
    }

    // Mobile hamburger
    const toggle = document.getElementById('ef-topnav-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const nav = document.getElementById('ef-topnav')!;
        const isOpen = nav.classList.toggle('ef-topnav-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    }
  }

  function gotoBlock(pageIdx: number, blockIdx: number) {
    const blockEl = document.getElementById(`ef-block-${pageIdx}-${blockIdx}`);
    if (navMode === 'fullpage') {
      // Snap to the page; blocks within a page sit on the same viewport.
      goToPage(pageIdx);
      // For long pages in fullpage, also scroll the inner container so the
      // target block is visible. Fullpage's outer container is transformed,
      // so use scrollIntoView on the block which still works inside .ef-page.
      setTimeout(() => blockEl?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 720);
    } else {
      blockEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // --- Navigation Dots ---
  function buildDots() {
    const c = document.getElementById('ef-dots')!;
    c.innerHTML = '';
    for (let i = 0; i < totalPages; i++) {
      const d = document.createElement('button');
      d.className = `ef-dot${i === currentPage ? ' active' : ''}`;
      d.addEventListener('click', () => goToPage(i));
      c.appendChild(d);
    }
  }

  function updateDots() {
    document.querySelectorAll('.ef-dot').forEach((d, i) =>
      d.classList.toggle('active', i === currentPage)
    );
    if (currentPage > 0) {
      document.getElementById('ef-scroll-hint')?.classList.add('hidden');
    }
  }

  // --- Navigation ---
  function goToPage(idx: number) {
    if (idx < 0 || idx >= totalPages || idx === currentPage || isScrolling) return;
    isScrolling = true;
    currentPage = idx;
    if (navMode === 'fullpage') {
      document.getElementById('ef-pages')!.style.transform = `translateY(-${currentPage * 100}vh)`;
    } else {
      const page = document.querySelectorAll('.ef-page')[idx] as HTMLElement;
      if (page) page.scrollIntoView({ behavior: 'smooth' });
    }
    updateDots();
    triggerPageAnimations(currentPage);
    setTimeout(() => { isScrolling = false; }, 700);
  }

  if (navMode === 'fullpage') {
    window.addEventListener('wheel', (e: WheelEvent) => {
      if (isScrolling || (e.target as HTMLElement).closest('.ef-form-scrollable')) return;
      if (e.deltaY > 30) goToPage(currentPage + 1);
      else if (e.deltaY < -30) goToPage(currentPage - 1);
    }, { passive: true });

    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => { touchStartY = e.touches[0].clientY; }, { passive: true });
    window.addEventListener('touchend', (e) => {
      if (isScrolling) return;
      const dy = touchStartY - e.changedTouches[0].clientY;
      if (dy > 50) goToPage(currentPage + 1);
      else if (dy < -50) goToPage(currentPage - 1);
    }, { passive: true });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault(); goToPage(currentPage + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault(); goToPage(currentPage - 1);
      }
    });
  }

  // Apply navigation mode to root: one explicit class either way.
  // Free scroll is the default (no special overflow handling); fullpage
  // adds the class that locks body scroll for the snap engine.
  root.classList.add(navMode === 'fullpage' ? 'ef-nav-fullpage' : 'ef-nav-scroll');
  if (!showDots) {
    root.classList.add('ef-no-dots');
  }

  document.addEventListener('ef:next', () => goToPage(currentPage + 1));

  // --- Block Rendering (delegates to theme) ---
  function renderBlock(block: any, theme: ThemeDefinition): string {
    const renderer = theme.blocks[block.type];
    if (!renderer) return `<div class="ef-unknown">[unknown block: ${block.type}]</div>`;
    return renderer(block);
  }

  function renderAllPages() {
    const container = document.getElementById('ef-pages')!;
    const theme = getTheme(currentTheme);
    container.innerHTML = '';

    for (const page of siteConfig.pages) {
      const pageEl = document.createElement('div');
      pageEl.className = `ef-page ef-page-${page.id} ${theme.cssClass}`;

      // Apply page-level background
      if (page.background) {
        if (page.background.startsWith('http') || page.background.startsWith('/')) {
          pageEl.style.backgroundImage = `url(${page.background})`;
          pageEl.style.backgroundSize = 'cover';
          pageEl.style.backgroundPosition = 'center';
        } else {
          pageEl.style.background = page.background;
        }
      }

      // Determine page-level max width: widest block dictates inner width
      const defaultWidths: Record<string, string> = {
        pricing: 'wide', features: 'wide', links: 'narrow',
        testimonials: 'wide', logos: 'wide', faq: 'normal',
      };
      let pageWidth = '';
      for (const block of page.blocks) {
        const bw = block.pageWidth && block.pageWidth !== 'auto' ? block.pageWidth : defaultWidths[block.type] || '';
        if (bw === 'full') { pageWidth = 'full'; break; }
        if (bw === 'wide' && pageWidth !== 'full') pageWidth = 'wide';
        if (bw === 'narrow' && !pageWidth) pageWidth = 'narrow';
      }
      const widthClass = pageWidth ? ` ef-page-${pageWidth}` : '';

      let html = '';
      const pageIdx = siteConfig.pages.indexOf(page);
      let blockIdx = 0;
      for (const block of page.blocks) {
        const anim = block.animation;
        let animClass = '';
        let animStyle = '';
        if (anim && anim.type && anim.type !== 'none') {
          animClass = ` ef-anim ef-anim-pending`;
          animStyle = ` data-anim="ef-anim-${anim.type}"`;
          if (anim.delay) animStyle += ` data-anim-delay="${anim.delay}"`;
        }
        // Block spacing
        const spacing = block.spacing;
        if (spacing && spacing !== 'normal') animClass += ` ef-block-${spacing}`;

        // Block background
        let bgStyle = '';
        if (block.blockBackground?.value) {
          const bg = block.blockBackground;
          if (bg.type === 'image') bgStyle = ` style="background-image:url(${bg.value});background-size:cover;background-position:center"`;
          else bgStyle = ` style="background:${bg.value}"`;
          animClass += ' ef-block-bg';
        }

        const tBlock = currentLang ? translateBlock(block) : block;
        const blockId = `ef-block-${pageIdx}-${blockIdx}`;
        html += `<div id="${blockId}" class="ef-block ef-block-${block.type}${animClass}"${animStyle}${bgStyle}>${renderBlock(tBlock, theme)}</div>`;
        blockIdx++;
      }
      pageEl.innerHTML = `<div class="ef-page-inner${widthClass}">${html}</div>`;
      container.appendChild(pageEl);
    }

    bindFormEvents();
    bindFAQEvents();
    // Small delay ensures browser has painted the initial frame (opacity:0)
    // before we trigger animations — without this the first page stays blank.
    setTimeout(() => triggerPageAnimations(currentPage), 50);
    if (navMode === 'fullpage') {
      container.style.transform = `translateY(-${currentPage * 100}vh)`;
    } else {
      // In scroll mode, all pages are simultaneously in flow but blocks with
      // animation start at opacity:0. Without an IntersectionObserver, pages
      // beyond #0 would never reveal their content because triggerPageAnimations
      // only fires on goToPage() which scroll mode doesn't auto-call.
      bindScrollAnimationObserver();
    }
  }

  // IntersectionObserver: when a page scrolls into view in scroll mode, fire
  // its animations exactly once. Idempotent — pages already triggered are
  // skipped via dataset.animDone.
  let scrollObs: IntersectionObserver | null = null;
  function bindScrollAnimationObserver() {
    if (scrollObs) scrollObs.disconnect();
    scrollObs = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const page = entry.target as HTMLElement;
        if (page.dataset.animDone === '1') continue;
        const idx = Array.prototype.indexOf.call(page.parentElement?.children || [], page);
        triggerPageAnimations(idx);
        page.dataset.animDone = '1';
      }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    document.querySelectorAll('.ef-page').forEach(p => scrollObs!.observe(p));
  }

  // --- Form Submission ---
  function bindFormEvents() {
    document.querySelectorAll('.ef-form-wrap').forEach(wrap => {
      const wrapEl = wrap as HTMLElement;
      const errEl = wrap.querySelector('.ef-error') as HTMLElement;
      const successEl = wrap.querySelector('.ef-success') as HTMLElement;
      const endpoint = wrapEl.dataset.endpoint!;
      const formId = wrapEl.dataset.formId || '';

      // Legacy single-email form
      const emailInput = wrap.querySelector('.ef-email') as HTMLInputElement;
      if (emailInput) {
        const btn = wrap.querySelector('.ef-submit') as HTMLButtonElement;
        if (!btn) return;
        const doSubmit = async () => {
          const email = emailInput.value.trim();
          if (!email) return;
          errEl?.classList.add('hidden');
          btn.disabled = true;
          const orig = btn.textContent;
          btn.textContent = '...';
          try {
            const start = performance.now();
            const res = await fetch(`${apiBase}${endpoint}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const ms = Math.round(performance.now() - start);
            const data = await res.json() as any;
            if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
            (wrap.querySelector('.ef-form-row') as HTMLElement).style.display = 'none';
            successEl?.classList.remove('hidden');
            const lt = successEl?.querySelector('.ef-latency-text');
            if (lt) lt.textContent = `Submitted in ${data.latency_ms ?? ms}ms from the edge.`;
            try {
              const cr = await fetch(`${apiBase}${endpoint}/count`);
              const cd = await cr.json() as any;
              const ct = successEl?.querySelector('.ef-count-text');
              if (ct) ct.textContent = `You are #${cd.count} on the waitlist.`;
            } catch {}
            const badge = document.getElementById('ef-latency')!;
            badge.textContent = `${data.latency_ms ?? ms}ms`;
            badge.classList.remove('hidden');
          } catch (e: any) {
            if (errEl) { errEl.textContent = e.message || 'Something went wrong'; errEl.classList.remove('hidden'); }
            btn.disabled = false;
            btn.textContent = orig;
          }
        };
        btn.addEventListener('click', doSubmit);
        emailInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSubmit(); });
        return;
      }

      // Multi-field / multi-step form
      const submitBtn = wrap.querySelector('.ef-submit-full, .ef-step-next') as HTMLButtonElement;
      if (!submitBtn) return;

      // Multi-step navigation
      const steps = wrap.querySelectorAll('.ef-step');
      const dots = wrap.querySelectorAll('.ef-progress-dot');
      const prevBtn = wrap.querySelector('.ef-step-prev') as HTMLButtonElement;
      const nextBtn = wrap.querySelector('.ef-step-next') as HTMLButtonElement;
      let stepIdx = 0;

      function showStep(i: number) {
        steps.forEach((s, j) => { (s as HTMLElement).classList.toggle('active', j === i); });
        dots.forEach((d, j) => { d.classList.toggle('active', j === i); d.classList.toggle('done', j < i); });
        if (prevBtn) prevBtn.style.visibility = i === 0 ? 'hidden' : 'visible';
        if (nextBtn) nextBtn.textContent = i === steps.length - 1 ? 'Submit' : 'Next';
        stepIdx = i;
      }

      if (prevBtn) prevBtn.addEventListener('click', () => { if (stepIdx > 0) showStep(stepIdx - 1); });

      // Collect all form data
      function collectFormData(): Record<string, any> {
        const data: Record<string, any> = {};
        wrap.querySelectorAll('input, textarea, select').forEach(el => {
          const input = el as HTMLInputElement;
          const name = input.name;
          if (!name) return;
          if (input.type === 'checkbox') {
            if (!data[name]) data[name] = [];
            if (input.checked) (data[name] as string[]).push(input.value);
          } else if (input.type === 'radio') {
            if (input.checked) data[name] = input.value;
          } else {
            data[name] = input.value;
          }
        });
        return data;
      }

      // Validate current step's required fields
      function validateStep(): boolean {
        const activeStep = wrap.querySelector('.ef-step.active') || wrap;
        let valid = true;
        // Required single inputs (text, textarea, select, single checkbox)
        activeStep.querySelectorAll('input[required], textarea[required], select[required]').forEach(el => {
          const input = el as HTMLInputElement;
          if (input.type === 'checkbox') {
            if (!input.checked) { input.classList.add('ef-invalid'); valid = false; }
            else { input.classList.remove('ef-invalid'); }
          } else if (!input.value.trim()) { input.classList.add('ef-invalid'); valid = false; }
          else { input.classList.remove('ef-invalid'); }
        });
        // Required groups (radio / checkbox with options) — at least one must be checked
        activeStep.querySelectorAll('.ef-check-group[data-required="true"]').forEach(group => {
          const checked = (group as HTMLElement).querySelector('input:checked');
          if (!checked) { (group as HTMLElement).classList.add('ef-invalid'); valid = false; }
          else { (group as HTMLElement).classList.remove('ef-invalid'); }
        });
        return valid;
      }

      const doMultiSubmit = async () => {
        if (!validateStep()) return;
        // Multi-step: advance to next step if not last
        if (steps.length > 0 && stepIdx < steps.length - 1) { showStep(stepIdx + 1); return; }

        const btn = (steps.length > 0 ? nextBtn : submitBtn) as HTMLButtonElement;
        errEl?.classList.add('hidden');
        btn.disabled = true;
        const orig = btn.textContent;
        btn.textContent = '...';
        try {
          const start = performance.now();
          const formData = collectFormData();
          const submitEndpoint = formId ? `${apiBase}/api/submit` : `${apiBase}${endpoint}`;
          // Optional client meta — server-side only stores it when collectMeta
          // is enabled in the site config, so safe to always send.
          const clientMeta: Record<string, any> = {};
          try {
            clientMeta.tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            clientMeta.lang = navigator.language;
            clientMeta.viewport = `${window.innerWidth}x${window.innerHeight}`;
            clientMeta.screen = `${screen.width}x${screen.height}`;
            if (document.referrer) clientMeta.referrer = document.referrer;
          } catch {}
          const body = formId
            ? { formId, siteId, data: formData, _client_meta: clientMeta }
            : formData;
          const res = await fetch(submitEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const ms = Math.round(performance.now() - start);
          const data = await res.json() as any;
          if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
          // Hide form content, show success
          wrap.querySelectorAll('.ef-form-grid, .ef-step, .ef-step-progress, .ef-step-nav, .ef-submit-full').forEach(el => { (el as HTMLElement).style.display = 'none'; });
          successEl?.classList.remove('hidden');
          const lt = successEl?.querySelector('.ef-latency-text');
          if (lt) lt.textContent = `Submitted in ${data.latency_ms ?? ms}ms from the edge.`;
          const badge = document.getElementById('ef-latency')!;
          badge.textContent = `${data.latency_ms ?? ms}ms`;
          badge.classList.remove('hidden');
        } catch (e: any) {
          if (errEl) { errEl.textContent = e.message || 'Something went wrong'; errEl.classList.remove('hidden'); }
          btn.disabled = false;
          btn.textContent = orig;
        }
      };

      if (nextBtn) nextBtn.addEventListener('click', doMultiSubmit);
      if (submitBtn && submitBtn !== nextBtn) submitBtn.addEventListener('click', doMultiSubmit);
    });
  }

  // --- FAQ Accordion ---
  function bindFAQEvents() {
    document.querySelectorAll('.ef-faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.ef-faq-item')!;
        item.classList.toggle('open');
      });
    });
  }

  // --- Countdown Timers ---
  function initCountdowns() {
    document.querySelectorAll('.ef-countdown').forEach(cd => {
      const el = cd as HTMLElement;
      const target = new Date(el.dataset.target!).getTime();
      const expired = el.dataset.expired || 'Time is up!';
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          el.innerHTML = `<div class="ef-countdown-expired">${expired}</div>`;
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        const set = (key: string, val: number) => {
          const span = el.querySelector(`[data-cd="${key}"]`);
          if (span) span.textContent = String(val).padStart(2, '0');
        };
        set('days', d); set('hours', h); set('minutes', m); set('seconds', s);
      }
      tick();
      setInterval(tick, 1000);
    });
  }

  // --- Animations ---
  function triggerPageAnimations(pageIdx: number) {
    const pages = document.querySelectorAll('.ef-page');
    const page = pages[pageIdx];
    if (!page) return;
    page.querySelectorAll('.ef-anim-pending').forEach(el => {
      const block = el as HTMLElement;
      const animClass = block.dataset.anim;
      const delay = parseInt(block.dataset.animDelay || '0', 10);
      if (!animClass) return;
      setTimeout(() => {
        block.classList.remove('ef-anim-pending');
        block.classList.add(animClass);
      }, delay);
    });
  }

  // --- Language Picker ---
  const LANG_LABELS: Record<string, string> = {
    'zh-CN': '简体', 'zh-TW': '繁體', 'zh-HK': '港式',
    'pt-BR': 'PT-BR',
  };
  function langLabel(code: string): string {
    return LANG_LABELS[code] || code.toUpperCase();
  }

  function buildLangPicker() {
    if (!hasI18n) return;
    const picker = document.getElementById('ef-lang-picker')!;
    picker.style.display = 'flex';
    const container = document.getElementById('ef-lang-pills')!;
    container.innerHTML = '';

    // Source language pill
    const srcBtn = document.createElement('button');
    srcBtn.className = `ef-pill${!currentLang ? ' active' : ''}`;
    srcBtn.textContent = sourceLangLabel;
    srcBtn.addEventListener('click', () => switchLang(''));
    container.appendChild(srcBtn);

    // Target language pills
    for (const lang of targetLangs) {
      const btn = document.createElement('button');
      btn.className = `ef-pill${lang === currentLang ? ' active' : ''}`;
      btn.textContent = langLabel(lang);
      btn.addEventListener('click', () => switchLang(lang));
      container.appendChild(btn);
    }
  }

  function switchLang(lang: string) {
    currentLang = lang;
    const url = new URL(location.href);
    if (lang) url.searchParams.set('lang', lang);
    else url.searchParams.delete('lang');
    history.replaceState(null, '', url.toString());
    buildLangPicker();
    renderAllPages();
    initCountdowns();
  }

  // --- Collapsible side pickers (mobile only) ---
  // The CSS hides pills by default at ≤768px until the picker has .ef-sw-open.
  // Toggle on icon click; collapse on outside click / Escape / pill pick.
  function bindSidePickerToggles() {
    const themeNav = document.getElementById('ef-switcher');
    const langNav = document.getElementById('ef-lang-picker');
    const themeBtn = document.getElementById('ef-sw-toggle');
    const langBtn = document.getElementById('ef-lang-toggle');
    function close(nav: HTMLElement | null, btn: HTMLElement | null) {
      if (!nav) return;
      nav.classList.remove('ef-sw-open');
      btn?.setAttribute('aria-expanded', 'false');
    }
    function toggle(nav: HTMLElement | null, btn: HTMLElement | null, otherNav: HTMLElement | null, otherBtn: HTMLElement | null) {
      if (!nav) return;
      const open = nav.classList.toggle('ef-sw-open');
      btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) close(otherNav, otherBtn);
    }
    themeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle(themeNav, themeBtn, langNav, langBtn);
    });
    langBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle(langNav, langBtn, themeNav, themeBtn);
    });
    // Click outside to close
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (themeNav && !themeNav.contains(t)) close(themeNav, themeBtn);
      if (langNav && !langNav.contains(t)) close(langNav, langBtn);
    });
    // Picking a pill auto-closes the picker (saves a tap). Use delegation so
    // pills rebuilt later (e.g. on theme switch) still auto-close.
    themeNav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.ef-pill')) close(themeNav, themeBtn);
    });
    langNav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.ef-pill')) close(langNav, langBtn);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        close(themeNav, themeBtn);
        close(langNav, langBtn);
      }
    });
  }

  // --- Init ---
  buildPills();
  buildLangPicker();
  buildDots();
  buildTopNav();
  bindSidePickerToggles();
  renderAllPages();
  initCountdowns();
</script>

<!-- Engine-only styles: layout, switcher, dots, badge. No theme visuals. -->
<style is:global>
  :root { --ef-primary: #f97316; }
  /* Default body scroll is visible; only fullpage mode locks it for snap. */
  html, body { height: 100%; }
  .hidden { display: none !important; }

  /* Fullpage mode: lock body scroll so the snap engine handles navigation. */
  .ef-nav-fullpage, .ef-nav-fullpage body { overflow: hidden; height: 100vh; }
  .ef-nav-fullpage .ef-pages {
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .ef-nav-fullpage .ef-page {
    height: 100vh;
    overflow: hidden;
  }
  .ef-nav-fullpage .ef-page-inner { max-height: 92vh; overflow-y: auto; }

  .ef-page {
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .ef-page::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.02) 0%, transparent 60%);
    pointer-events: none;
  }
  .ef-page-inner {
    width: 100%; max-width: 780px; padding: 3rem 2.5rem;
    display: flex; flex-direction: column; gap: 2rem;
    position: relative; z-index: 1;
    transition: max-width 0.3s ease;
  }
  .ef-page-inner.ef-page-narrow { max-width: 560px; }
  .ef-page-inner.ef-page-wide { max-width: 1080px; }
  .ef-page-inner.ef-page-full { max-width: 1320px; }
  .ef-block { position: relative; }

  /* Free scroll mode (default): page flows naturally, dots float.
     Override theme rules that force min-height:100vh on .ef-page so pages stack snugly. */
  .ef-nav-scroll .ef-page { min-height: auto !important; }
  .ef-nav-scroll .ef-scroll-hint { display: none; }
  /* Hide dots when explicitly disabled (per-site setting; or legacy nav:none) */
  .ef-no-dots .ef-dots { display: none; }

  /* Site brand (logo + optional name) */
  .ef-site-brand {
    position: fixed; top: 1.25rem; left: 1.25rem; z-index: 100;
    display: inline-flex; align-items: center; gap: 0.55rem;
    opacity: 0.92; transition: opacity 0.2s;
  }
  .ef-site-brand:hover { opacity: 1; }
  .ef-brand-logo {
    height: 32px; max-width: 140px; object-fit: contain;
    border-radius: 6px;
  }
  .ef-brand-name {
    font-size: 0.95rem; font-weight: 700; letter-spacing: -0.01em;
    /* Inherit the theme's foreground colour. Brand mark is identity, not a CTA;
       painting it in the accent makes it compete with actual call-to-actions
       and clashes with logos that already have their own colour treatment. */
    color: inherit;
  }

  .ef-switcher {
    position: fixed; z-index: 100;
    display: flex; align-items: center; gap: 0.65rem;
    font-family: var(--mono, monospace); font-size: 0.72rem;
  }
  /* Collapsible toggle button — visible only on mobile */
  .ef-sw-toggle {
    display: none;
    width: 38px; height: 38px;
    align-items: center; justify-content: center;
    background: var(--ui-panel, rgba(10,10,15,0.82));
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid var(--ui-border, rgba(255,255,255,0.08));
    border-radius: 12px;
    color: var(--ui-text, rgba(255,255,255,0.75));
    cursor: pointer; padding: 0;
    box-shadow: var(--ui-shadow, 0 4px 16px rgba(0,0,0,0.3));
    transition: color 0.2s, border-color 0.2s;
  }
  .ef-sw-toggle:hover { color: var(--accent, #f97316); border-color: rgba(var(--accent-rgb, 249, 115, 22), 0.3); }
  .ef-sw-top-right { top: 1.25rem; right: 1.25rem; }
  .ef-sw-top-left { top: 1.25rem; left: 3.5rem; }
  .ef-sw-bottom-right { bottom: 1.25rem; right: 1.25rem; }
  .ef-sw-bottom-left { bottom: 1.25rem; left: 3.5rem; }
  .ef-sw-label { color: var(--ui-dim, rgba(255,255,255,0.3)); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; font-size: 0.6rem; }
  .ef-sw-pills {
    display: flex; gap: 2px;
    background: var(--ui-panel, rgba(10,10,15,0.82)); backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid var(--ui-border, rgba(255,255,255,0.08));
    border-radius: 12px; padding: 3px;
    box-shadow: var(--ui-shadow, 0 8px 32px rgba(0,0,0,0.4));
  }
  .ef-pill {
    padding: 0.4rem 0.85rem; border: none; border-radius: 9px;
    background: transparent; color: var(--ui-dim, rgba(255,255,255,0.35));
    font-family: inherit; font-size: 0.68rem; font-weight: 600;
    cursor: pointer; transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    letter-spacing: 0.02em;
  }
  .ef-pill:hover { color: var(--ui-text, rgba(255,255,255,0.75)); background: var(--ui-hover, rgba(255,255,255,0.06)); }
  .ef-pill.active {
    color: #fff; background: var(--accent, #f97316); font-weight: 700;
    box-shadow: 0 2px 12px color-mix(in srgb, var(--accent, #f97316) 40%, transparent);
  }

  /* Language picker */
  .ef-lang-picker {
    position: fixed; z-index: 100;
    bottom: 1.25rem; left: 3.5rem;
    display: flex; align-items: center; gap: 0.65rem;
    font-family: var(--mono, monospace); font-size: 0.72rem;
  }

  /* Page dots */
  .ef-dots {
    position: fixed; left: 1.35rem; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 12px; z-index: 100;
  }
  .ef-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--ui-dim, rgba(255,255,255,0.1)); border: 1.5px solid transparent;
    cursor: pointer; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative; opacity: 0.4;
    box-sizing: border-box;
  }
  .ef-dot:hover {
    opacity: 0.7;
    transform: scale(1.3);
  }
  .ef-dot.active {
    background: var(--accent, #f97316); opacity: 1;
    border-color: transparent;
    transform: scale(1);
    width: 10px; height: 28px; border-radius: 5px;
    box-shadow: 0 0 16px rgba(249,115,22,0.5), 0 0 4px rgba(249,115,22,0.3);
  }

  /* Top nav (optional, opt-in via siteConfig.topNav.enabled).
     --ef-topnav-h is declared at :root so it cascades EVERYWHERE
     (.ef-block, .ef-page-inner, switcher, lang picker — all read it). */
  :root { --ef-topnav-h: 56px; }
  @media (max-width: 720px) { :root { --ef-topnav-h: 52px; } }

  .ef-topnav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    background: rgba(10,10,15,0.78);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  /* Use scroll-padding on the actual scroll containers so click-nav AND any
     other programmatic scroll lands the same distance below the fixed bar.
